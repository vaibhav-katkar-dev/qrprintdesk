# Server Configuration
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# MongoDB Replica Set (Atlas or local replica set)
MONGO_URI=mongodb://localhost:27017/
DB_NAME=shopprint

# Storage Mode ('local' saves files directly on local disk for testing without R2; 'r2' uses Cloudflare S3)
STORAGE_MODE=local

# Cloudflare R2 Storage (Used when STORAGE_MODE=r2)
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<cloudflare_r2_access_key_id>
R2_SECRET_ACCESS_KEY=<cloudflare_r2_secret_access_key>
R2_BUCKET_NAME=shopprint-docs

# Cashfree Payment Gateway
CASHFREE_ENV=SANDBOX # Or PRODUCTION
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

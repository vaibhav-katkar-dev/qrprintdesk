{
  "name": "shopprint",
  "version": "1.0.0",
  "description": "Zero-touch local photocopy shop print server",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "loadtest": "node tests/load_test.js",
    "simulate:avg": "node scripts/load_simulator.js --mode=avg --target=https://qrprintdesk.in",
    "simulate:worst": "node scripts/load_simulator.js --mode=worst --target=https://qrprintdesk.in",
    "simulate:local": "node scripts/load_simulator.js --mode=avg --target=http://localhost:3000"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@fastify/websocket": "^11.3.4",
    "alpinejs": "^3.17.4",
    "bonjour-service": "^1.3.0",
    "cashfree-pg": "^6.0.6",
    "dotenv": "^18.0.8",
    "fastify": "^5.2.1",
    "mongodb": "^7.7.0",
    "pdf-lib": "^1.17.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "autocannon": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
